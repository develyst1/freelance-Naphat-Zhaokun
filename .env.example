PORT=3110                      # port the web listens on (127.0.0.1 only)
LLM_GATEWAY_URL=https://ai.develyst.online   # the owner's LLM gateway; server-side only
LLM_GATEWAY_KEY=               # empty today (the gateway needs no key); sent as Bearer if set
LLM_PROVIDER=                  # optional: openai|gemini|xai|deepseek; empty = gateway fallback chain
LLM_MODEL=                     # optional model name for LLM_PROVIDER
DEMO_PASSWORD=                 # the one shared password on the page; made by `bun run setup`
SESSION_SECRET=                # reserved; made by `bun run setup` (sessions are server-side ids)
RATE_LIMIT_PER_HOUR=30         # chat messages per visitor session per hour
MAX_UPLOAD_MB=10               # largest upload
